PORT=10000
NODE_ENV=development

# MongoDB connection string (never commit the real one)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=

# Optional bootstrap admin account. The admin user is only created when both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gmail SMTP (App Password) used for password reset codes and admin emails
SMTP_USER=
SMTP_PASS=

# AI chat providers. /api/chat is disabled when no key is configured.
EYEGPT_API_KEY=
OPENROUTER_API_KEY=

# Public origin, sent as the OpenRouter HTTP-Referer header
PUBLIC_URL=http://localhost:10000
